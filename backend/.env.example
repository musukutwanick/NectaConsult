# Django Security & Core Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=nectaconsult.azurewebsites.net,nectaconsult.co.zw,localhost,127.0.0.1

# Azure Managed PostgreSQL Flexible Server Database Configuration
# Option A: Full Connection String URL
DATABASE_URL=postgres://nectaadmin:YourStrongPassword123!@nectaconsult-db.postgres.database.azure.com:5432/nectaconsult?sslmode=require

# Option B: Individual PostgreSQL Parameters
DB_HOST=nectaconsult-db.postgres.database.azure.com
DB_NAME=nectaconsult
DB_USER=nectaadmin
DB_PASSWORD=YourStrongPassword123!
DB_PORT=5432
DB_SSLMODE=require

# Azure Blob Storage Configuration for Secure Medical Documents
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=nectastorage;AccountKey=your_account_key;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=medical-documents

# Microsoft Entra ID / Azure AD Credentials for NectaCare Microsoft Graph Email Service
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# Microsoft 365 Sender Mailbox
GRAPH_SENDER_EMAIL=nectaconsult@nectacare.co.zw

# Optional SMTP Fallback Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=nectaconsult@nectacare.co.zw
EMAIL_HOST_PASSWORD=your_password_here
DEFAULT_FROM_EMAIL=NectaCare <nectaconsult@nectacare.co.zw>

